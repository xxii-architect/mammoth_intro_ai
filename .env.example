# MammothOS / ATLAS environment variables
# Copy to .env (never commit the real .env)

# ── Supabase — required for cloud persistence ────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── OpenAI — optional (used if MAMMOTH_LLM_ADAPTER is not set or =openai) ───
OPENAI_API_KEY=<your-openai-key>
# gpt-4o-mini is recommended — fast, cheap, fully sufficient
OPENAI_MODEL=gpt-4o-mini

# ── Local Ollama models — optional (auto-detected if Ollama is running) ──────
# Set MAMMOTH_LLM_ADAPTER to one of:
#   ollama        → use OLLAMA_MODEL (default: hermes3:8b)
#   hermes        → hermes3:8b  (great for ATLAS tutor/hints)
#   deepseek      → deepseek-coder:latest  (great for CodingAgent)
#   codellama     → codellama:latest
#   qwen-coder    → qwen2.5-coder:latest
#   llama         → llama3.1:8b
#   mistral       → mistral:latest
#   qwen          → qwen2.5:latest
#   phi           → phi3:latest
#   openai        → force OpenAI even if Ollama is running
#   local         → deterministic echo (CI / offline testing only)
#
# If neither OPENAI_API_KEY nor MAMMOTH_LLM_ADAPTER is set,
# MammothOS will auto-detect a running Ollama instance.
MAMMOTH_LLM_ADAPTER=ollama
OLLAMA_MODEL=hermes3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=llama3.1:8b

# ── ATLAS runtime overrides (optional) ───────────────────────────────────────
ATLAS_EXERCISE_GEN_MODE=template        # template | llm
ATLAS_USER_ID=cli_user
FORCE_SUBPROCESS_FALLBACK=0             # 1 = skip Docker (use while WSL2 kernel is broken)
SANDBOX_RUNNER_MODE=auto                # auto | subprocess | docker
