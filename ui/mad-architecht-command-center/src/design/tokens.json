{
  "$description": "MammothOS semantic design tokens (W3C Design Tokens Community Group format). Source of truth for src/design/tokens.css. Edit here, then run `npm run tokens`.",
  "$version": "1.0.0",
  "color": {
    "$type": "color",
    "surface": {
      "shell": { "$value": "#050608" },
      "base": { "$value": "#0d1117" },
      "raised": { "$value": "#161b22" },
      "sunken": { "$value": "#080a0e" }
    },
    "text": {
      "primary": { "$value": "#e2e8f0" },
      "secondary": { "$value": "#8b9ab0" },
      "muted": { "$value": "#6b7a90", "$description": "Raised from #4a5568 to meet 4.5:1 on surface.base." }
    },
    "border": {
      "subtle": { "$value": "rgba(255,255,255,0.08)" },
      "strong": { "$value": "rgba(255,255,255,0.16)" },
      "focus": { "$value": "#4da6ff" }
    },
    "system": {
      "$description": "Navigation and system state. Blue carries system meaning.",
      "default": { "$value": "#4da6ff" },
      "soft": { "$value": "rgba(77,166,255,0.12)" }
    },
    "agent": {
      "$description": "The single agent accent (copper). Only for agent activity, agent-authored content, and pending approval.",
      "default": { "$value": "#d08a52" },
      "soft": { "$value": "rgba(208,138,82,0.14)" },
      "strong": { "$value": "#e6a06a" }
    },
    "status": {
      "success": { "$value": "#34d399" },
      "warning": { "$value": "#f5b942" },
      "info": { "$value": "#8b9ab0" },
      "danger": { "$value": "#f87171", "$description": "Reserved for irreversible operations and failures." }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": { "$value": "Inter, system-ui, -apple-system, Segoe UI, sans-serif" },
    "mono": { "$value": "JetBrains Mono, ui-monospace, SFMono-Regular, Consolas, monospace" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "pill": { "$value": "999px" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
