# Supabase public keys (safe to expose in frontend)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# Optional guest/demo access. Keep false unless Supabase anonymous auth is enabled on purpose.
VITE_ENABLE_GUEST_SIGN_IN=false
# Optional when the frontend is deployed separately from the backend.
# Point this at the backend origin only; /api is added automatically.
VITE_MAMMOTH_API_BASE_URL=https://<your-backend-host>
# Optional alias for API base if you prefer this variable name.
VITE_MAMMOTH_BACKEND_URL=https://<your-backend-host>
# Optional frontend fallback admin emails used only when the entitlement API is temporarily unavailable.
# This is not the source of truth for backend admin access; set MAMMOTH_ADMIN_EMAILS / MAMMOTH_ADMIN_USER_IDS in the root .env for that.
VITE_MAMMOTH_ADMIN_EMAILS=truexxiisupply@gmail.com
# Contact emails shown in Login + Compliance pages.
VITE_MAMMOTH_SUPPORT_EMAIL=hello@truexxiisupply.com
VITE_MAMMOTH_PRIVACY_EMAIL=privacy@truexxiisupply.com
